<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns="http://www.springframework.org/schema/beans"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:p="http://www.springframework.org/schema/p"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
                        http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
    <bean id = "fast" class = "car.drive.Engine">
        <constructor-arg value="electric"></constructor-arg>
        <constructor-arg value="SUV"></constructor-arg>

    </bean>
    <bean id = "chalak" class="car.drive.Driver">
        <constructor-arg value="James Bond"/>
        <constructor-arg value="007"/>
    </bean>
    <bean id = "maruti" class="car.drive.Car">
        <constructor-arg value="Toyota"></constructor-arg>
        <constructor-arg ref="chalak"></constructor-arg>
        <constructor-arg ref="fast"></constructor-arg>
    </bean>
</beans>